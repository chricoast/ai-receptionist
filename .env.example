# Copy this file to .env.local and fill in the values.
# Both values are safe to be public (they end up in the browser anyway);
# Row Level Security in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: the public address of the app, used in email links.
# If empty, it is taken from the incoming request.
NEXT_PUBLIC_SITE_URL=

# NEVER put the Supabase secret / service_role key in a NEXT_PUBLIC_ variable.
